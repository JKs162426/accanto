# ── Database ────────────────────────────────────────────────────────────
# Local: run `npm run db:start` and use the URL it prints.
# Production: Vercel Postgres / Neon / Supabase connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/accanto"
# Connections per server instance. Use 1 with `prisma dev` (single-session PGlite).
DATABASE_POOL_MAX=""

# ── Auth ────────────────────────────────────────────────────────────────
# Signs the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL, used for links inside emails.
APP_URL="http://localhost:3000"

# ── Cron ────────────────────────────────────────────────────────────────
# Bearer token required by GET /api/emails (email queue + reminders).
# Vercel Cron sends it automatically when the variable is named CRON_SECRET.
CRON_SECRET=""

# ── Email ───────────────────────────────────────────────────────────────
# Provider selection: RESEND_API_KEY wins; otherwise SMTP if EMAIL_HOST is
# set; otherwise emails are printed to the server console (dev mode).
RESEND_API_KEY=""
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="tu-email@gmail.com"
EMAIL_PASSWORD="tu-app-password"
EMAIL_FROM="Accanto <noreply@accanto.local>"
# Where "new reservation" / "cancelled" admin alerts go.
ADMIN_NOTIFICATION_EMAIL="admin@accanto.local"
# Language of staff alert emails: "it" (default) or "en". Guest emails use the
# language each booking was made in.
ADMIN_EMAIL_LOCALE="it"

# ── Public demo ─────────────────────────────────────────────────────────
# Show the demo credentials on the login screens in production.
# Anyone can then sign in as admin, so also set the allowlist below.
DEMO_MODE=""
# Only deliver email to these recipients (comma-separated; "@domain" allowed),
# e.g. "@accanto.local,you@example.com". Empty = no restriction.
EMAIL_RECIPIENT_ALLOWLIST=""
